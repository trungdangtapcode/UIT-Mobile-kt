<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="0dp" android:clipToOutline="false">
 <ImageView android:id="@android:id/background" android:clipToOutline="true" android:src="@drawable/widget_preview_frame" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" />
 <LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="20dp" android:paddingTop="12dp" android:paddingBottom="12dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
  <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/uit_emblem" android:contentDescription="UIT Mobile" android:importantForAccessibility="no" />
  <TextView android:id="@+id/widget_heading" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:fontFamily="@font/ibm_plex_sans_semibold" android:textSize="13sp" android:textColor="#65BEFF" android:text="@string/widget_next_heading" />
  <TextView android:id="@+id/widget_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/ibm_plex_mono_regular" android:textSize="10sp" android:textColor="#A0B0BF" android:text="GMT+07" />
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"><LinearLayout android:id="@+id/widget_row_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="8dp" android:paddingBottom="6dp" android:background="?android:attr/selectableItemBackground" android:contentDescription="@string/widget_open_schedule">
    <TextView android:id="@+id/widget_row_0_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/ibm_plex_sans_regular" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#E6F2FF" android:text="Your saved timetable"  />
    <TextView android:id="@+id/widget_row_0_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/ibm_plex_sans_semibold" android:textSize="15sp" android:maxLines="2" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#E6F2FF" android:text="@string/widget_loading_title"  />
    <TextView android:id="@+id/widget_row_0_room" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/ibm_plex_sans_regular" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#E6F2FF" android:text="@string/widget_loading_body"  />
    </LinearLayout><TextView android:id="@+id/widget_compact_deadline" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/ibm_plex_sans_regular" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#E6F2FF" android:text="@string/widget_deadline_heading" android:paddingTop="4dp" /></LinearLayout>
 <TextView android:id="@+id/widget_saved" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/ibm_plex_sans_regular" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#E6F2FF" android:text="@string/widget_saved"  />
 </LinearLayout>
</FrameLayout>
